<Window x:Class="Karbantarto.Windows.Gyakorlatok"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Karbantarto.Windows"
        mc:Ignorable="d"
        Title="Gyakorlatok" Height="480" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel >
            <Label Content="Id"/>
            <TextBox x:Name="txb_Id" IsReadOnly="True"/>
            <Label Content="Edzés neve"/>
            <TextBox x:Name="txb_EdzesNev" TextWrapping="NoWrap"/>
            <Label Content="Izomcsoport"/>
            <TextBox x:Name="txb_Izomcsoport"/>
            <Label Content="Leírás"/>
            <TextBox x:Name="txb_Leiras"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Új" 
                Click="UjEdzes" FontWeight="Bold"/>
                <Button Content="Törlés"
                Click="EdzesTorol" FontWeight="Bold"/>
                <Button Content="Módosítás" 
                Click="EdzesModosit" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="dtg_Edzesek" Grid.Column="1" AutoGenerateColumns="False" SelectionChanged="dtgAdatSelChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding exerciseId}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Muscle Group" Binding="{Binding muscleGroup}" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
